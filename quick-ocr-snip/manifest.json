{
  "manifest_version": 3,
  "name": "Quick OCR Snip",
  "description": "Select any visible area on a webpage, OCR it locally with Tesseract.js, and copy the text.",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Quick OCR Snip",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-ocr-snip": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Start Quick OCR Snip"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "lang/*",
        "ocr-frame.html",
        "ocr-frame.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
